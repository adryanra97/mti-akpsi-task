# WAJIB di Production. Rahasia penandatangan sesi login, minimal 32 karakter acak.
# Buat dengan: openssl rand -base64 48
AUTH_SECRET=

# WAJIB di Production. Kata sandi akun pengujian (sama untuk semua peran), minimal 8 karakter.
# Jangan menuliskannya di kode, README, atau halaman web; bagikan lewat kanal yang aman.
DEMO_PASSWORD=

# Database Postgres (otomatis diisi integrasi Neon di Vercel). Kosong = database sementara di memori.
DATABASE_URL=

# Mode LLM: isi minimal satu (opsional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Opsional: layanan kompatibel OpenAI (OpenRouter, Groq, dll.)
OPENAI_BASE_URL=
GEMINI_API_KEY=

# Pengembangan lokal saja: alamat uvicorn Core Module (python -m uvicorn api.index:app --port 8000)
CORE_MODULE_DEV_URL=
